{
  "name": "immersive-folder",
  "version": "0.2.4",
  "description": "Immerse the file explorer in the folder you are working in.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "sync": "npm run build && node sync.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "iBlinkQ",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
